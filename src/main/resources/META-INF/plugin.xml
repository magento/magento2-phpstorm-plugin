<idea-plugin require-restart="true">
    <depends>JavaScript</depends>
    <depends>com.intellij.css</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.platform.images</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>com.intellij.copyright</depends>
    <depends>com.intellij.mcpServer</depends>
    <depends optional="true" config-file="withPhp.xml">com.jetbrains.php</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.magento.idea.magento2plugin.project.Settings"/>
        <projectService serviceImplementation="com.magento.idea.magento2plugin.project.startup.DeferredProjectOpenActions"/>

        <projectConfigurable
                groupId="tools"
                provider="com.magento.idea.magento2plugin.project.ToolsConfigurableProvider"
                id="Magento2.SettingsForm"
                displayName="Magento"
                nonDefaultProject="true"/>

        <psi.referenceContributor language="JavaScript" implementation="com.magento.idea.magento2plugin.reference.js.JsReferenceContributor"/>
        <psi.referenceContributor language="JSON" implementation="com.magento.idea.magento2plugin.reference.json.JsonReferenceContributor"/>
        <psi.referenceContributor language="HTML" implementation="com.magento.idea.magento2plugin.reference.html.HtmlReferenceContributor"/>

        <fileBasedIndex implementation="com.magento.idea.magento2plugin.stubs.indexes.ModulePackageIndex" />
        <fileBasedIndex implementation="com.magento.idea.magento2plugin.stubs.indexes.xml.ModuleXmlIndex" />
        <fileBasedIndex implementation="com.magento.idea.magento2plugin.stubs.indexes.js.RequireJsIndex" />
        <fileBasedIndex implementation="com.magento.idea.magento2plugin.stubs.indexes.js.JsMixinIndex" />
        <fileBasedIndex implementation="com.magento.idea.magento2plugin.stubs.indexes.js.KnockoutTemplateIndex" />
        <fileBasedIndex implementation="com.magento.idea.magento2plugin.stubs.indexes.js.MagentoLibJsIndex" />

        <codeInsight.lineMarkerProvider language="JavaScript" implementationClass="com.magento.idea.magento2plugin.linemarker.js.JsMixinLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JavaScript" implementationClass="com.magento.idea.magento2plugin.linemarker.js.KnockoutTemplateLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="HTML" implementationClass="com.magento.idea.magento2plugin.linemarker.js.KnockoutTemplateLineMarkerProvider"/>

        <directoryProjectConfigurator implementation="com.magento.idea.magento2plugin.project.ProjectDetector"/>
        <multiHostInjector implementation="com.magento.idea.magento2plugin.lang.injection.UiComponentSyntaxInjector"/>

        <errorHandler implementation="com.magento.idea.magento2plugin.project.diagnostic.DefaultErrorReportSubmitter"/>

        <notificationGroup
                id="Magento Notifications"
                displayType="BALLOON" />

        <projectViewNodeDecorator implementation="com.magento.idea.magento2plugin.decorator.MagentoFolderDecorator"/>
    </extensions>
</idea-plugin>
