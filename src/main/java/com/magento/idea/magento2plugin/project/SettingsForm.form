<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.magento.idea.magento2plugin.project.SettingsForm">
  <grid id="27dc6" binding="panel" default-binding="true" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="570" height="220"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="61372" layout-manager="FormLayout">
        <rowspec value="center:max(d;4px):noGrow"/>
        <rowspec value="top:3dlu:noGrow"/>
        <rowspec value="center:max(d;4px):noGrow"/>
        <rowspec value="top:3dlu:noGrow"/>
        <rowspec value="center:max(d;4px):noGrow"/>
        <rowspec value="top:3dlu:noGrow"/>
        <rowspec value="center:max(d;4px):noGrow"/>
        <rowspec value="top:3dlu:noGrow"/>
        <rowspec value="center:max(d;4px):noGrow"/>
        <rowspec value="top:3dlu:noGrow"/>
        <rowspec value="center:max(d;4px):noGrow"/>
        <colspec value="fill:max(d;4px):noGrow"/>
        <colspec value="left:4dlu:noGrow"/>
        <colspec value="fill:max(d;4px):noGrow"/>
        <colspec value="left:4dlu:noGrow"/>
        <colspec value="fill:d:grow"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="3" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="93ec7" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties>
              <text value="XML configuration:"/>
            </properties>
          </component>
          <component id="7bde6" class="javax.swing.JLabel" binding="moduleDefaultLicenseNameLabel">
            <constraints>
              <grid row="8" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties>
              <text value="Default license name for new modules:"/>
            </properties>
          </component>
          <component id="87330" class="javax.swing.JTextField" binding="moduleDefaultLicenseName">
            <constraints>
              <grid row="8" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
              <forms defaultalign-horz="false"/>
            </constraints>
            <properties>
              <maximumSize width="150" height="40"/>
              <toolTipText value="Custom License Name"/>
            </properties>
          </component>
          <component id="c0fa2" class="javax.swing.JLabel" binding="magentoPathLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties>
              <text value="Magento installation path:"/>
            </properties>
          </component>
          <component id="99b4d" class="com.intellij.openapi.ui.TextFieldWithBrowseButton" binding="magentoPath">
            <constraints>
              <grid row="2" column="4" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties/>
          </component>
          <component id="f0d37" class="javax.swing.JButton" binding="regenerateUrnMapButton">
            <constraints>
              <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <forms defaultalign-horz="false"/>
            </constraints>
            <properties>
              <horizontalAlignment value="0"/>
              <text value="Regenerate URN mappings"/>
            </properties>
          </component>
          <component id="aad3b" class="javax.swing.JTextField" binding="magentoVersion">
            <constraints>
              <grid row="4" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
              <forms defaultalign-horz="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="b8bb9" class="javax.swing.JLabel" binding="magentoVersionLabel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties>
              <text value="Platform Version:"/>
            </properties>
          </component>
          <component id="bc0cc" class="javax.swing.JLabel">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties>
              <text value="MCP CLI wrapper candidates:"/>
            </properties>
          </component>
          <component id="ec5e7" class="javax.swing.JTextField" binding="mcpCliToolCandidates">
            <constraints>
              <grid row="6" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
              <forms defaultalign-horz="false"/>
            </constraints>
            <properties>
              <toolTipText value="Comma-separated relative paths that the MCP CLI discovery tool should prioritize, for example bin/magento, bin/n98-magerun2, bin/cli"/>
            </properties>
          </component>
          <component id="43433" class="javax.swing.JLabel">
            <constraints>
              <grid row="10" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties>
              <text value="Agent skills:"/>
              <toolTipText value="Install bundled Magento AI skills into the selected agent target. These skills are starter playbooks for Magento scaffolding and inspection workflows. After installation you can fine-tune them for your team by editing the skill files and adding project-specific instructions, commands, and workflows."/>
            </properties>
          </component>
          <grid id="4119d" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="4">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="10" column="4" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="2f4e1" class="javax.swing.JComboBox" binding="skillAgentTargetSelect">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="120" height="-1"/>
                  </grid>
                </constraints>
                <properties>
                  <toolTipText value="Select where the bundled Magento skills should be installed. Use this to target the agent workspace you want to extend. Installed skills are meant to be customized later with your own prompts, commands, and workflow steps."/>
                </properties>
              </component>
              <grid id="55ec1" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="6" vgap="-1">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                  <forms/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="3e3c5" class="javax.swing.JButton" binding="installMagentoScaffoldSkillButton">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Scaffold"/>
                      <toolTipText value="Install or update the bundled Magento scaffold skill for the selected agent target. Use it as a starting point for Magento code generation flows, then adjust the skill file to match your preferred prompts, commands, and delivery workflow."/>
                    </properties>
                  </component>
                  <component id="a8a4a" class="javax.swing.JButton" binding="installMagentoInspectSkillButton">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Inspect"/>
                      <toolTipText value="Install or update the bundled Magento inspect skill for the selected agent target. Use it as a starting point for project lookup and analysis tasks, then extend the skill with your own instructions, commands, and workflow conventions."/>
                    </properties>
                  </component>
                </children>
              </grid>
            </children>
          </grid>
        </children>
      </grid>
      <component id="2ef99" class="javax.swing.JCheckBox" binding="pluginEnabled">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <selected value="false"/>
          <text value="Enable Magento integration"/>
        </properties>
      </component>
      <component id="47a96" class="javax.swing.JButton" binding="buttonReindex">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <enabled value="true"/>
          <text value="Reindex"/>
        </properties>
      </component>
      <hspacer id="ef977">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <component id="9231f" class="javax.swing.JCheckBox" binding="mftfSupportEnabled">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Enable MFTF support"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
